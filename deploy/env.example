# Şifre hash'i üret:
#   python3 -c "from passlib.context import CryptContext; c=CryptContext(schemes=['bcrypt']); print(c.hash('ŞIFRENIZI_BURAYA_YAZIN'))"
APP_USERNAME=admin
APP_PASSWORD_HASH=$2b$12$REPLACE_THIS_WITH_REAL_HASH

# Session imzalama anahtarı (rastgele üret):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# HTTPS modunda session cookie güvenli olsun
HTTPS_ONLY=true

# Session süresi saniye cinsinden (43200 = 12 saat)
SESSION_MAX_AGE=43200

# Google Sheets ID (Ayarlar UI'ından da girilebilir)
GOOGLE_SHEET_ID=
