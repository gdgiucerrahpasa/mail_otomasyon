# Google OAuth for admin panel login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated list of admin emails
ADMIN_EMAILS=admin@example.com,other@example.com

# Session signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret

# Google Sheets ID (can also be set in Settings UI)
GOOGLE_SHEET_ID=

# SQLite DB path (default: ./mail_web.db)
# DATABASE_URL=sqlite:///./mail_web.db
